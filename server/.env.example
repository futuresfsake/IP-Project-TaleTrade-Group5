# Export these before `npm start` (never commit real values).
PORT=3000
# Number of reverse proxies in front of the API (usually 1 on a hosting platform). Leave unset when
# clients reach the server directly, or they could fake their address and dodge the rate limit.
# TRUST_PROXY=1
# Used server-side only, so the Feed screens never ship a Google Books key in the APK.
GOOGLE_BOOKS_API_KEY=your_google_books_api_key
# Names locations pinned on the map (server-side reverse geocoding).
MAPTILER_API_KEY=your_maptiler_api_key
# Path to a Firebase service-account JSON kept OUTSIDE the repo
# (not needed on Cloud Run / GCE, which provide default credentials).
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json
